<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LANoireLauncher</AssemblyName>
    <!-- the release workflow overrides this from the git tag (v1.2.3 -> 1.2.3); the updater compares against it -->
    <Version>2.5.5</Version>
    <RootNamespace>LANoireLauncher</RootNamespace>
    <ApplicationIcon>Assets\lanoire.ico</ApplicationIcon>

    <!-- app identity (shows in Explorer > Properties and Task Manager) -->
    <Product>L.A. Noire Advanced Launcher</Product>
    <AssemblyTitle>L.A. Noire Advanced Launcher</AssemblyTitle>
    <Description>L.A. Noire Advanced Launcher</Description>

    <!-- lean output: one exe, no pdb, no language folders -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- where the single exe lands, for both `dotnet publish` and the auto-publish after a Release build -->
    <PublishDir>$(MSBuildProjectDirectory)\dist\</PublishDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <!-- only valid for self-contained: shrinks the runtime-free exe -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\lanoire.ico" />
    <Resource Include="Assets\lanoire.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- NVIDIA FXAA 3.11 header, written next to FXAA.fx when the downloaded packs did not bring it (see EnsureBundledHeaders) -->
    <EmbeddedResource Include="Assets\Fxaa3_11.h" LogicalName="Fxaa3_11.h" />
    <!-- default ReShade preset, copied into the launcher's Presets folder right after the ReShade runtime is installed (see SeedDefaultPreset) -->
    <EmbeddedResource Include="Assets\DefaultPreset.ini" LogicalName="DefaultPreset.ini" />
  </ItemGroup>

  <!-- A plain "Build" never makes a single file (only Publish does). So a Release build also publishes, leaving
       the one exe in .\dist\LANoireLauncher.exe. Debug builds and `dotnet publish` itself are not affected. -->
  <Target Name="PublishSingleExeAfterBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(_IsPublishing)' != 'true' And '$(NoPublishAfterBuild)' != 'true'">
    <CallTarget Targets="Publish" />
  </Target>
</Project>
