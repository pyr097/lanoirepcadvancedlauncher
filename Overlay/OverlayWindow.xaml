<Window x:Class="LANoireLauncher.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False" IsHitTestVisible="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- Same look as DXVK's HUD: bold monospace, coral "FPS:" label, white value, no panel. -->
  <StackPanel Orientation="Horizontal">
    <StackPanel.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Effect">
          <Setter.Value><DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="1"/></Setter.Value>
        </Setter>
      </Style>
    </StackPanel.Resources>
    <TextBlock x:Name="FpsLabel" Text="FPS:" Foreground="#F28585"/>
    <TextBlock x:Name="FpsText" Text=" --.-"/>
    <TextBlock x:Name="TagText" Text="DXVK" Visibility="Collapsed"/>
  </StackPanel>
</Window>
