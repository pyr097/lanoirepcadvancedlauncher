<Window x:Class="LANoireLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L.A. Noire Advanced Launcher" Height="720" Width="860" MinHeight="620" MinWidth="780"
        WindowStartupLocation="CenterScreen" Icon="Assets/lanoire.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="UpdateBtn" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Click="UpdateBtn_Click" Margin="0,0,18,0"/>
          <TextBlock Text="PROFILE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ComboBox x:Name="ProfileBox" Width="170" IsEditable="True"/>
          <Button Content="Load" Click="LoadProfile_Click" Margin="8,0,0,0"/>
          <Button Content="Save" Click="SaveProfile_Click" Margin="6,0,0,0"/>
          <Button Content="Delete" Click="DeleteProfile_Click" Margin="6,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Image Source="Assets/lanoire.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="L.A. NOIRE" FontFamily="Georgia" FontWeight="Bold" FontSize="19"/>
            <TextBlock Text="ADVANCED LAUNCHER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- tabs -->
    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="24,12,24,0">

      <!-- PLAY -->
      <TabItem Header="Play">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,10,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="GAME FOLDER" Style="{StaticResource SectionLabel}"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Auto-detect" Click="AutoDetect_Click" Margin="6,0,0,0"/>
                  <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseGame_Click" Margin="8,0,0,0"/>
                  <TextBox x:Name="GamePathBox" IsReadOnly="True"/>
                </DockPanel>
                <TextBlock x:Name="InfoText" Style="{StaticResource Hint}" FontFamily="Consolas" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="LAUNCH OPTIONS" Style="{StaticResource SectionLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Text="Force resolution (-res W H)" VerticalAlignment="Center" Width="200"/>
                  <TextBox x:Name="ResWBox" Width="72"/>
                  <TextBlock Text=" × " VerticalAlignment="Center"/>
                  <TextBox x:Name="ResHBox" Width="72"/>
                  <TextBlock Text="   empty = use settings.ini" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                </StackPanel>
                <CheckBox x:Name="IgnoreFocusBox" Content="Keep running when alt-tabbed (-ignorefocus)" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Extra arguments" VerticalAlignment="Center" Width="200"/>
                  <TextBox x:Name="ExtraArgsBox" Width="340"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="FPS COUNTER" Style="{StaticResource SectionLabel}"/>
                <CheckBox x:Name="OverlayBox" Content="Show FPS while playing" Click="OverlayBox_Click"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="With DXVK on, DXVK's own counter is shown. With DXVK off, a small badge appears in the top-right corner of the game window (windowed or borderless; Ctrl+Shift+F shows/hides it) and needs the launcher to run as administrator. Nothing is injected into the game."/>
                <TextBlock x:Name="OverlayMsgText" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="RESTORE TO STOCK" Style="{StaticResource SectionLabel}"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Puts the game folder back to how it was before this launcher: removes ReShade, DXVK and V-Patch (only files this launcher installed; a dinput8.dll, d3d11.dll or dxgi.dll you had before is restored), reverts the Enhancements and restores settings.ini to its first version. Your shaders, presets, profiles and backups in %AppData% are kept."/>
                <Button Content="Restore everything to stock…" Click="RestoreStock_Click" HorizontalAlignment="Left" Padding="18,8"/>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
              <Button Content="PLAY (and Save)" Style="{StaticResource PrimaryButton}" Click="Launch_Click" Padding="46,11" FontSize="14"
                      ToolTip="Applies all settings, then starts the game"/>
              <Button Content="Save Options" Click="Apply_Click" Padding="18,11" Margin="10,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- V-PATCH -->
      <TabItem Header="V-Patch">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,10,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="INSTALL" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="PatchStatusText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Install from zip…" Click="InstallZip_Click"/>
                  <Button Content="Download latest" Click="DownloadPatch_Click" Margin="8,0,0,0"/>
                  <Button Content="Uninstall" Click="UninstallPatch_Click" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="SETTINGS (lanvp.ini)" Style="{StaticResource SectionLabel}"/>
                <StackPanel x:Name="PatchPanel"/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                       Text="V-Patch © VaanaCZ, CC BY-NC 4.0 (non-commercial). Bundled loader: Ultimate ASI Loader © ThirteenAG, MIT. Not affiliated with Rockstar Games or Take-Two."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- VULKAN -->
      <TabItem Header="Vulkan (DXVK)">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,10,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="DXVK" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="DxvkStatusText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                           Text="The game always runs on DirectX 11. DXVK optionally translates it to Vulkan. Install it, tick the box, then play from this launcher. Unticking the box and applying removes the DXVK files again. Frame limiting is done only by V-Patch's fps_limit."/>
                <CheckBox x:Name="DxvkEnableBox" Content="Render with Vulkan (DXVK)" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBlock Text="DXVK version" Width="120" VerticalAlignment="Center"/>
                  <ComboBox x:Name="DxvkVersionBox" Width="140" IsEditable="True" Text="latest">
                    <ComboBoxItem Content="latest"/>
                    <ComboBoxItem Content="v1.10.3"/>
                  </ComboBox>
                  <TextBlock Text="   v1.10.3 = older GPUs without Vulkan 1.3" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Install from archive…" Click="DxvkInstallArchive_Click"/>
                  <Button Content="Download" Click="DxvkDownload_Click" Margin="8,0,0,0"/>
                  <Button Content="Uninstall" Click="DxvkUninstall_Click" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="ADVANCED" Style="{StaticResource SectionLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="DXVK log level" Width="120" VerticalAlignment="Center"/>
                  <ComboBox x:Name="DxvkLogBox" Width="130" SelectedIndex="0">
                    <ComboBoxItem Content="default"/>
                    <ComboBoxItem Content="none"/>
                    <ComboBoxItem Content="error"/>
                    <ComboBoxItem Content="warn"/>
                    <ComboBoxItem Content="info"/>
                    <ComboBoxItem Content="debug"/>
                  </ComboBox>
                  <TextBlock Text="   logs go to %AppData%\LANoireLauncher\dxvk-logs" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                </StackPanel>
                <TextBlock Text="Extra dxvk.conf lines (key = value, one per line, optional)" Style="{StaticResource Hint}" Margin="0,10,0,4"/>
                <TextBox x:Name="DxvkConfBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" VerticalContentAlignment="Top"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <TextBlock x:Name="DxvkCacheText" VerticalAlignment="Center" Width="260"/>
                  <Button Content="Clear shader/pipeline cache" Click="DxvkClearCache_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                       Text="DXVK © Philip Rebohle and contributors, zlib licence. Not affiliated with Rockstar Games or Take-Two."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- RESHADE -->
      <TabItem Header="ReShade">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,10,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="RESHADE" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="ReShadeStatusText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14" TextWrapping="Wrap"
                           Text="ReShade is loaded through V-Patch's ASI loader as plugins\ReShade32.asi (or 64). It does not use dxgi.dll or d3d11.dll, so it works the same with DXVK on or off. Unticking and applying only removes the .asi (ReShade.ini is kept so you can switch back). Remove from game puts the game folder back exactly as it was. Press Home in the game to open ReShade's overlay."/>
                <CheckBox x:Name="ReShadeEnableBox" Content="Enable ReShade" Margin="0,0,0,14" Click="ReShadeEnable_Click"/>
                <WrapPanel>
                  <Button Content="Check &amp; download missing files" Style="{StaticResource PrimaryButton}" Click="ReShadeCheck_Click" Margin="0,0,8,6"
                          ToolTip="Checks ReShade, V-Patch's loader and every effect file the selected preset needs, and offers to download whatever is missing."/>
                  <Button Content="Install from setup…" Click="ReShadeInstall_Click" Margin="0,0,8,6"/>
                  <Button Content="Download latest" Click="ReShadeDownload_Click" Margin="0,0,8,6"/>
                  <Button Content="Remove from game" Click="ReShadeRemove_Click" Margin="0,0,8,6"
                          ToolTip="Removes the .asi, ReShade.ini and ReShade.log (restores a ReShade.ini you had before). Shaders and presets in %AppData% are kept."/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="SHADERS" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="ShaderSummaryText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14" TextWrapping="Wrap"
                           Text="Anything a preset needs that is missing (iMMERSE, LumeniteFX, standard effects, ReShade itself) is offered for download when you pick the preset, tick Enable ReShade or press Save Options / PLAY. RTGI is paid, so it is added from a folder or zip you provide. Shaders / Textures folders, loose .fx files and preset .ini files inside are sorted into place. They are kept in %AppData%\LANoireLauncher\reshade, not in the game folder."/>
                <WrapPanel>
                  <Button Content="Add from folder…" Click="ShadersFolder_Click" Margin="0,0,8,6"/>
                  <Button Content="Add from zip…" Click="ShadersZip_Click" Margin="0,0,8,6"/>
                  <Button Content="Download standard effects" Click="ShadersStandard_Click" Margin="0,0,8,6"/>
                  <Button Content="Import from game folder" Click="ShadersFromGame_Click" Margin="0,0,8,6"
                          ToolTip="Copies reshade-shaders, reshade-presets and loose presets from an earlier manual ReShade install"/>
                  <Button Content="Open folder" Click="ShadersOpen_Click" Margin="0,0,8,6"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="PRESET" Style="{StaticResource SectionLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Text="Active preset" Width="120" VerticalAlignment="Center"/>
                  <ComboBox x:Name="ReShadePresetBox" Width="300" DropDownClosed="ReShadePresetBox_DropDownClosed"/>
                </StackPanel>
                <WrapPanel>
                  <Button Content="Import preset…" Click="PresetImport_Click" Margin="0,0,8,6"/>
                  <Button Content="Remove" Click="PresetRemove_Click" Margin="0,0,8,6"/>
                  <Button Content="Open folder" Click="PresetOpen_Click" Margin="0,0,8,6"/>
                  <Button Content="Make RTGI preset" Click="PresetRtgi_Click" Margin="0,0,8,6"/>
                  <Button Content="Make depth-check preset" Click="PresetDepth_Click" Margin="0,0,8,6"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="The chosen preset is written to ReShade.ini when you press Save Options or PLAY. '(leave as is)' keeps whatever ReShade has. The preset is part of a profile, so you can keep a plain profile and an RTGI profile."/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="RTGI NOTES" Style="{StaticResource SectionLabel}"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Text="RTGI is a paid shader, so the launcher cannot fetch it (everything else a preset needs it can): add the files you have with Add from folder / zip, then Make RTGI preset (it switches on the RTGI technique with default settings). RTGI needs the game's depth buffer. Make the depth-check preset, start the game, press Home and set the RESHADE_DEPTH_INPUT_* options until the DisplayDepth view looks right, then switch to the RTGI preset. If depth looks wrong or flickers, try Antialiasing = 0 on the Graphics tab."/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16" TextWrapping="Wrap"
                       Text="ReShade © crosire, BSD 3-Clause. Each shader keeps its author's licence. Not affiliated with Rockstar Games or Take-Two."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- GRAPHICS -->
      <TabItem Header="Graphics">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,10,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="SETTINGS FILE (settings.ini)" Style="{StaticResource SectionLabel}"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseSettings_Click" Margin="8,0,0,0"/>
                  <TextBox x:Name="SettingsPathBox" IsReadOnly="True"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="GRAPHICS" Style="{StaticResource SectionLabel}"/>
                <StackPanel x:Name="GfxPanel"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Renderer is fixed to DirectX 11 by the launcher."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ENHANCEMENTS -->
      <TabItem Header="Enhancements">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,10,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="REMASTER-STYLE ATTRIBUTE PATCHES" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="AtbStatusText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14" TextWrapping="Wrap"
                           Text="Copies selected values from what the PS4 remaster uses into the game's attribute database. It edits final\pc\out.wad.pc in place (file size never changes), checks every value first and keeps a journal so it can be reverted exactly. Pick the sets you want and press Apply: exactly those sets end up patched and the others are set back to original. Close the game first. A file-verification in the Rockstar launcher may flag the change: revert before verifying."/>

                <CheckBox x:Name="AtbFogBox" Margin="0,0,0,2" Content="Fog and draw distance (38 values)"/>
                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,10" TextWrapping="Wrap"
                           Text="Fog start/end, horizon fog, high-LOD draw distance, depth-of-field far plane. Subtle."/>

                <CheckBox x:Name="AtbLightBox" Margin="0,0,0,2" Content="Remaster lighting values (66 values) – experimental"/>
                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,10" TextWrapping="Wrap"
                           Text="Bloom threshold and intensity (the threshold is 4 times higher on PS4), light radius, brightness/contrast. These only copy the lighting values that changed; they may not look better, and the effect on neon signs is uncertain (see note below)."/>

                <CheckBox x:Name="AtbVehBox" Margin="0,0,0,2" Content="More vehicles in high detail (2 values)"/>
                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,12" TextWrapping="Wrap"
                           Text="High-LOD vehicles 5 → 10 and medium-LOD vehicles 12 → 24, as on the remaster. Costs some performance in dense traffic."/>

                <CheckBox x:Name="AtbExactBox" Margin="0,0,0,8"
                          Content="Use the exact PS4 fog values (no safe fog range)"
                          ToolTip="The remaster sets fog start equal to fog end in 9 records. By default the end is set to start + 1 to avoid a possible divide-by-zero in the older PC shader."/>
                <CheckBox x:Name="AtbBackupBox" Margin="0,0,0,14"
                          Content="Also keep a full copy of out.wad.pc (about 150 MB) as out.wad.pc.orig"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="AtbApplyBtn" Content="Apply selected" Style="{StaticResource PrimaryButton}" Click="AtbApply_Click" Padding="30,8"/>
                  <Button x:Name="AtbRevertBtn" Content="Revert all to original" Click="AtbRevert_Click" Margin="10,0,0,0" Padding="18,8"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="ABOUT NEON SIGNS AND THE REMASTER LIGHTING" Style="{StaticResource SectionLabel}"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Text="The neon light definitions (neon_light, neon_light_pp, ...) and all glow values are identical on PC and PS4, so there is nothing in the data to copy for them. The remaster look comes mostly from new rendering code and shaders that the PC executable does not have; a data patch cannot port that. The values above are the lighting data that did change."/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16" TextWrapping="Wrap"
                       Text="Works only on your own installation. The values were found by comparing the PC and PS4 attribute files of your own copies; no game data is included in this launcher."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ABOUT / UPDATES -->
      <TabItem x:Name="AboutTab" Header="About">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,10,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="LAUNCHER UPDATES" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="UpdateVersionText" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <Border x:Name="UpdateNotesBox" Visibility="Collapsed" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                  <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="UpdateNotesText" TextWrapping="Wrap" FontSize="12"/>
                  </ScrollViewer>
                </Border>
                <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Height="6" Minimum="0" Maximum="1" Margin="0,0,0,10"
                             Foreground="{StaticResource Accent}" Background="{StaticResource Surface2}" BorderThickness="0"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button x:Name="UpdateCheckBtn" Content="Check for updates" Click="UpdateCheck_Click"/>
                  <Button x:Name="UpdateInstallBtn" Content="Download and install" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="UpdateInstall_Click" Margin="8,0,0,0"/>
                  <Button x:Name="UpdateNotesBtn" Content="Release page" Visibility="Collapsed" Click="UpdateRelease_Click" Margin="8,0,0,0"/>
                  <Button x:Name="UpdateSkipBtn" Content="Skip this version" Visibility="Collapsed" Click="UpdateSkip_Click" Margin="8,0,0,0"/>
                </StackPanel>
                <CheckBox x:Name="UpdateAutoBox" Content="Check for updates when the launcher starts" Click="UpdateOptions_Click" Margin="0,0,0,4"/>
                <CheckBox x:Name="UpdatePreBox" Content="Include pre-releases (beta builds)" Click="UpdateOptions_Click"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Updates come from this project's GitHub releases. The download is checked against its published SHA-256 before the launcher replaces itself and restarts; your settings, profiles and backups in %AppData% are untouched. Nothing is downloaded without your confirmation."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="PROJECT" Style="{StaticResource SectionLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Open GitHub page" Click="OpenRepo_Click"/>
                  <Button Content="Open data folder" Click="OpenDataFolder_Click" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- status bar -->
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,10">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="34" Foreground="{StaticResource Muted}" FontSize="12"/>
    </Border>
  </Grid>
</Window>
